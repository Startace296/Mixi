# Copy to .env (next to docker-compose.yml) and fill in what you need.
# Everything is optional: `docker compose up --build` works without this file.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Auth — set a long random value for anything beyond local testing
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google login (same client ID is used by backend and frontend build)
GOOGLE_CLIENT_ID=

# Email OTP (signup / forgot password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TURN relay for calls
METERED_DOMAIN=
METERED_SECRET_KEY=
