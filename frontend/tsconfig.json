{
  // Migration mode: .js/.jsx and .ts/.tsx live side by side.
  // allowJs lets TS files import existing JS; checkJs stays off so untouched
  // JS files are not type-checked until they are renamed to .ts/.tsx.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "allowJs": true,
    "checkJs": false,

    // Strict from day one for new/converted TS files only.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["vite/client"]
  },
  "include": ["src", "tests"]
}
